# Copy the contents of this file into Streamlit Cloud → App Settings → Secrets
# Do NOT commit this file with real keys.

GEMINI_API_KEY = "paste-your-gemini-key-here"
GEMINI_MODEL = "gemini-2.5-flash"
GEMINI_FALLBACK_MODELS = "gemini-2.5-flash,gemini-1.5-flash"

MARKETAUX_API_TOKEN = "paste-your-marketaux-token-here"

FRED_API_KEY = "paste-your-fred-key-here"

# Optional: manual yield overrides (leave blank or remove if not needed)
# MANUAL_BUND_10Y = "2.45"
# MANUAL_CH_10Y = "0.55"

# Optional: override event marker dates
# IRAN_WAR_START_DATE = "2026-02-28"
# IRAN_CEASEFIRE_DATE = "2026-04-07"

# --- SNIPER Drive integration (broker research feed) ---
# SNIPER folder ID in Nikos's My Drive (contains research.csv).
[sniper_drive]
sniper_folder_id = "1hsCM44CFeulYTj9IIo4d8iy6_qlOptiB"

# Full service-account JSON. Paste contents of
# ~/.config/sniper/service_account.json as a TOML table.
# Only drive.readonly scope is needed on the Brief side.
[gcp_service_account]
type = "service_account"
project_id = "personal-assistant-489713"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "sniper-drive@personal-assistant-489713.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
